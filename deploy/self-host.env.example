# Generate with: openssl rand -hex 32
JOB_HARNESS_AUTH_TOKEN=replace-with-a-long-random-api-token

# Host directory for the SQLite database. It must be writable by container uid 1000.
JOB_HARNESS_DATA_DIR=./data

# Web is loopback-only by default. Use 0.0.0.0 only behind a deliberate firewall/Tailnet/reverse proxy.
JOB_HARNESS_WEB_BIND=127.0.0.1
JOB_HARNESS_WEB_PORT=3001

# Optional single-user Web login. Strongly recommended for any endpoint beyond a trusted private network.
JOB_HARNESS_WEB_PASSWORD=
# Generate with: openssl rand -base64 48
JOB_HARNESS_WEB_SESSION_SECRET=
JOB_HARNESS_WEB_SESSION_TTL_HOURS=168

# true when the browser reaches Job Harness over HTTPS. false is only for trusted HTTP/private development.
JOB_HARNESS_WEB_COOKIE_SECURE=false

# Optional custom image name/tag.
JOB_HARNESS_IMAGE=job-harness:local

# Durable external-submission recovery. Set interval to 0 to disable the background sweep.
JOB_HARNESS_SUBMISSION_RECONCILE_INTERVAL_MS=300000
# Mark browser work still "in progress" after this many milliseconds for manual review. Default: 2 hours.
JOB_HARNESS_SUBMISSION_STALE_AFTER_MS=7200000
JOB_HARNESS_SUBMISSION_MAX_AUTOMATIC_RETRIES=8
JOB_HARNESS_SUBMISSION_RECONCILE_BATCH_SIZE=100

# BOSS Copilot compatibility bridge. Compose keeps the MCP hop private on the service network
# and publishes the browser bridge only on host loopback. Override PUBLIC_URL when a private
# HTTPS/Tailnet reverse proxy exposes the bridge to the dedicated browser profile.
JOB_HARNESS_BOSS_BRIDGE_PORT=18788
JOB_HARNESS_BOSS_BRIDGE_PUBLIC_URL=http://127.0.0.1:18788
JOB_HARNESS_BOSS_SCORE_DELAY_MS=2500
JOB_HARNESS_BOSS_SCORE_DELAY_JITTER_MS=400
JOB_HARNESS_BOSS_GREETING_WAIT_MS=15000
JOB_HARNESS_BOSS_GREETING_THRESHOLD=58
JOB_HARNESS_BOSS_CAMPAIGN_ID=2026-grad-agent-fullstack-frontend
JOB_HARNESS_BOSS_DISCOVERY_IDLE_MS=600000
