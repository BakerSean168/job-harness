{
  "schemaVersion": 1,
  "id": "job-harness",
  "name": "Job Harness",
  "version": "0.2.0",
  "status": "standalone-alpha",
  "kind": "domain-extension",
  "description": "Plugin-ready career search, application pipeline, first-class Resume authoring, durable submission intents, and AI tool surface.",
  "provides": [
