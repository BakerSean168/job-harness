{% extends "base.njk" %}

{% block content %}
  {% if headerTemplate == "with-photo" %}
    {% include "blocks/header-with-photo.njk" %}
  {% else %}
    {% include "blocks/header-compact-inline.njk" %}
  {% endif %}

  {% for section in sections %}
    {% if section == "education" %}
      {% include "blocks/education.njk" %}
    {% elif section == "skills" %}
      {% include "blocks/skills.njk" %}
    {% elif section == "work" %}
      {% include "blocks/work-experience.njk" %}
    {% elif section == "projects" %}
      {% include "blocks/projects-compact-links.njk" %}
    {% elif section == "certificates" %}
      {% include "blocks/certificates.njk" %}
    {% elif section == "summary" %}
      {% include "blocks/summary.njk" %}
    {% endif %}
  {% endfor %}
{% endblock %}
