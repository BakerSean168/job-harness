{
  "name": "job-harness",
  "version": "0.2.0",
  "private": true,
  "description": "Plugin-ready job search harness for AI-assisted career workflows",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "smoke:deployment": "bash scripts/smoke-deployment.sh",
    "e2e": "pnpm build:web && playwright test",
    "e2e:headed": "pnpm build:web && playwright test --headed",
    "typecheck": "tsc -b && pnpm --filter @job-harness/web typecheck",
    "test": "vitest run",
    "check": "pnpm check:manifest && pnpm check:boundaries && pnpm check:chatgpt-integration && pnpm typecheck && pnpm check:openapi && pnpm test && pnpm build:web",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "server": "pnpm --filter @job-harness/server start",
    "import:legacy": "pnpm --filter @job-harness/server import:legacy",
    "build:web": "pnpm --filter @job-harness/web build",
    "web": "pnpm --filter @job-harness/web dev",
    "openapi:generate": "tsx scripts/openapi-artifact.ts --write",
    "check:openapi": "tsx scripts/openapi-artifact.ts",
    "resume:legacy:dry-run": "tsx scripts/resume-legacy-dry-run.ts",
    "resume:legacy:import": "tsx scripts/resume-legacy-import.ts",
    "check:chatgpt-integration": "tsx scripts/check-chatgpt-integration.ts",
    "smoke:chatgpt-mcp": "pnpm --filter @job-harness/server smoke:chatgpt-mcp",
    "import:legacy-ledger": "pnpm --filter @job-harness/server import:legacy-ledger",
    "smoke:apply-worker:steel": "pnpm --filter @job-harness/apply-worker smoke:steel",
    "smoke:apply-synthetic": "pnpm --filter @job-harness/apply-worker smoke:synthetic",
    "smoke:apply-shadow-inspect": "pnpm --filter @job-harness/apply-worker smoke:shadow-inspect"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "tsx": "^4.20.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
