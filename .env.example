# Standalone server defaults
JOB_HARNESS_DB=./data/job-harness.db
JOB_HARNESS_HOST=127.0.0.1
JOB_HARNESS_PORT=3000

# Required when binding to 0.0.0.0 or ::
JOB_HARNESS_AUTH_TOKEN=

# Server-side Web adapter (never expose the bearer token through NEXT_PUBLIC_*)
JOB_HARNESS_API_URL=http://127.0.0.1:3000/api/v1
# Optional single-user Web session. Leave JOB_HARNESS_WEB_PASSWORD empty to disable.
JOB_HARNESS_WEB_PASSWORD=
JOB_HARNESS_WEB_SESSION_SECRET=
JOB_HARNESS_WEB_SESSION_TTL_HOURS=168
# Defaults to true in production. Set false only for trusted HTTP/local environments.
JOB_HARNESS_WEB_COOKIE_SECURE=true

# Durable external-submission reconciliation. Set interval to 0 to disable the background sweep.
JOB_HARNESS_SUBMISSION_RECONCILE_INTERVAL_MS=300000
# Stale in-progress browser work is sent to manual review after 2 hours by default.
JOB_HARNESS_SUBMISSION_STALE_AFTER_MS=7200000
JOB_HARNESS_SUBMISSION_MAX_AUTOMATIC_RETRIES=8
JOB_HARNESS_SUBMISSION_RECONCILE_BATCH_SIZE=100
