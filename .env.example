# Standalone server defaults
JOB_HARNESS_DB=./data/job-harness.db
JOB_HARNESS_HOST=127.0.0.1
JOB_HARNESS_PORT=3000

# Required when binding to 0.0.0.0 or ::
JOB_HARNESS_AUTH_TOKEN=

# Server-side Web adapter (never expose the bearer token through NEXT_PUBLIC_*)
JOB_HARNESS_API_URL=http://127.0.0.1:3000/api/v1
