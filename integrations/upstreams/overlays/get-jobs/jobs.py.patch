+class ZhilianNativeFilters(BaseModel):
+    # Zhilian has a single-select experience dropdown. Only accept bands
+    # observed on its actual 2026-10-20 UI. '2' is the site's full-time type.
+    model_config = ConfigDict(extra="forbid")
+    experienceCodes: list[Literal["-1", "0001", "0103"]] = Field(min_length=1, max_length=3)
+    employmentCode: Literal["2"]
+
+
+_zhilian_native_filters: ZhilianNativeFilters | None = None
+
+
+@router.get("/zhilian/collection-filters", response_model=dict)
+async def get_zhilian_collection_filters():
+    return {
+        "success": _zhilian_native_filters is not None,
+        "experienceCodes": (
+            _zhilian_native_filters.experienceCodes if _zhilian_native_filters else []
+        ),
+        "employmentCode": (
+            _zhilian_native_filters.employmentCode if _zhilian_native_filters else None
+        ),
+    }
+
+
+@router.put("/zhilian/collection-filters", response_model=ApiResponse)
+async def configure_zhilian_collection_filters(value: ZhilianNativeFilters):
+    global _zhilian_native_filters
+    if os.getenv("JOB_HARNESS_GET_JOBS_COLLECT_ONLY") != "1":
+        return ApiResponse(success=False, message="Job Harness collect-only marker required", status="unsafe")
+    if task_state.running:
+        return ApiResponse(success=False, message="Cannot change filters during collection", status="running")
+    if len(set(value.experienceCodes)) != len(value.experienceCodes):
+        return ApiResponse(success=False, message="Duplicate experience band", status="invalid_filters")
+    _zhilian_native_filters = value
+    return ApiResponse(success=True, message="Zhilian native search filters configured")
 
 
