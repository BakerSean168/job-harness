+_login_tasks: dict[str, asyncio.Task] = {}
+
+
+def _start_platform_login(platform: str) -> bool:
+    """Start at most one interactive login browser per platform."""
+    existing = _login_tasks.get(platform)
+    if existing and not existing.done():
+        return False
+
+    task = asyncio.create_task(_run_platform_login(platform))
+    _login_tasks[platform] = task
+
+    def _cleanup(done_task: asyncio.Task):
+        if _login_tasks.get(platform) is done_task:
+            _login_tasks.pop(platform, None)
+
+    task.add_done_callback(_cleanup)
+    return True
+
 
 async def _run_platform_login(platform: str):
     """Open browser, wait for user login, save cookies."""
