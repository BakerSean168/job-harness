+    async def observe_job(self, data: dict) -> ZhilianData:
+        """Insert or refresh a cached row and stamp the latest real collection observation."""
+        job_id = data.get("job_id")
+        result = await self.session.execute(select(ZhilianData).where(ZhilianData.job_id == job_id))
+        job = result.scalar_one_or_none()
+        if job is None:
+            job = ZhilianData(**data)
+            self.session.add(job)
+        else:
+            for key, value in data.items():
+                if key not in {"id", "created_at", "updated_at", "delivered"} and hasattr(job, key):
+                    setattr(job, key, value)
+            job.updated_at = datetime.now(timezone.utc).replace(tzinfo=None)
+        await self.session.commit()
+        await self.session.refresh(job)
+        return job
+
